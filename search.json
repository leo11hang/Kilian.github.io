---
layout: null
---
[
  {% assign faq_questions = site.data.faq.questions %}
  {% for post in site.posts %}
  {
    "kind": "post",
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | truncate: 120 | jsonify }},
    "categories": {{ post.categories | join: ',' | jsonify }},
    "tags": {{ post.tags | join: ',' | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "cover": {{ post.cover | default: '' | jsonify }}
  }{% unless forloop.last and faq_questions.size == 0 %},{% endunless %}
  {% endfor %}
  {% for question in faq_questions %}
    {% assign faq_category = site.data.faq.categories | where: 'id', question.category | first %}
    {% assign faq_keywords = question.keywords | join: ' ' %}
    {% assign faq_search_text = question.question | append: ' ' | append: question.answer | append: ' ' | append: faq_keywords | append: ' ' | append: faq_category.name | append: ' ' | append: faq_category.description %}
  {
    "kind": "faq",
    "title": {{ question.question | jsonify }},
    "url": {{ '/faq/questions/' | append: question.id | append: '/' | relative_url | jsonify }},
    "excerpt": {% if question.answer and question.answer != '' %}{{ question.answer | strip_html | truncate: 180 | jsonify }}{% else %}{{ '该问题已列入知识目录，答案仍待研究。' | jsonify }}{% endif %},
    "categories": "faq",
    "category_name": {{ faq_category.name | default: 'AI Knowledge Base' | jsonify }},
    "category_description": {{ faq_category.description | default: '' | jsonify }},
    "tags": {{ question.keywords | join: ',' | jsonify }},
    "search_text": {{ faq_search_text | jsonify }},
    "date": {{ question.last_verified | default: '' | jsonify }},
    "status": {{ question.status | jsonify }},
    "cover": ""
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
